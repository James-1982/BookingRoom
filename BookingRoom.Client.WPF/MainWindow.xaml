<Window x:Class="BookingRoom.Client.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BookingRoom.Client.WPF.Views"
        Title="Booking Room Client"
        Height="600"
        Width="900">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- ======================= -->
        <!-- LEFT PANEL (ROOMS) -->
        <!-- ======================= -->
        <StackPanel Grid.Column="0"
                    Background="Transparent"
                    VerticalAlignment="Stretch">

            <!-- HEADER -->
            <TextBlock Text="Rooms"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="10,10,10,5"
                       HorizontalAlignment="Left" />

            <!-- LISTA ROOMS -->
            <ListBox ItemsSource="{Binding Rooms}"
                     Margin="12"
                     SelectedItem="{Binding DayBookingsContainer.SelectedRoom, Mode=TwoWay}"
                     SelectionMode="Single">

                <!-- ITEM STYLE SENZA HOVER / SELEZIONE WPF -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">

                        <!-- base pulito -->
                        <Setter Property="Background"
                                Value="Transparent" />
                        <Setter Property="BorderThickness"
                                Value="0" />
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <Setter Property="MaxWidth"
                                Value="300" />

                        <!-- rimuove stile default WPF -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- TEMPLATE ROOM -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <local:RoomCard Width="200"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </StackPanel>

        <Border Grid.Column="1"
                Background="#E0E0E0"
                Width="1"
                Margin="0,10" />

        <!-- ======================= -->
        <!-- RIGHT PANEL -->
        <!-- ======================= -->
        <Grid Grid.Column="2" Margin="8,0">

            <!-- PLACEHOLDER -->
            <TextBlock Text="Seleziona una stanza"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DayBookingsContainer.SelectedRoom}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>

            </TextBlock>

            <!-- DAY BOOKINGS CONTAINER -->
            <local:DayBookingsContainer Margin="10"
                                        DataContext="{Binding DayBookingsContainer}"
                                        >

                <local:DayBookingsContainer.Style>
                    <Style TargetType="local:DayBookingsContainer">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedRoom}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:DayBookingsContainer.Style>

            </local:DayBookingsContainer>

        </Grid>

    </Grid>

</Window>