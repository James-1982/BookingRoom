<UserControl x:Class="BookingRoom.Client.WPF.Views.DayBookingsContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BookingRoom.Client.WPF.Views"
             Margin="5">

    <Grid x:Name="Root"
          Opacity="1"
          RenderTransformOrigin="0.5,0.5">

        <!-- TRANSFORM PER SLIDE -->
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform"
                                X="0" />
        </Grid.RenderTransform>

        <!-- ===================== -->
        <!-- LAYOUT -->
        <!-- ===================== -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="8,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3">

                <TextBlock Text="{Binding SelectedRoom.Room.Name}"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="8,2,4,2" />

                <TextBlock Text=" (occupata)"
                           FontSize="18"
                           Margin="0,2"
                           VerticalAlignment="Bottom"
                           Visibility="{Binding HasActiveBooking, Converter={StaticResource BooleanToVisibilityConverter}}" />

            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="1" Grid.Column="0">
                
                <TextBlock Text="{Binding SelectedRoom.Room.Capacity, StringFormat=Capienza: {0}}"
                           Margin="8,2"
                           Foreground="#696969"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRoom}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>

                <TextBlock Text="{Binding SelectedRoom.BookingCount, StringFormat=Prenotazioni: {0}}"
                           Margin="8,2"
                           Foreground="#696969"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRoom}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>

                <TextBlock Text="{Binding SelectedRoom.BookingExpiredCount, StringFormat=Scadute: {0}}"
                           Margin="8,2"
                           Foreground="#696969"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"
                           FontSize="14"
                           >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRoom}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>

            <Button Grid.Column="2"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="8"
                    Padding="10,5"
                    HorizontalAlignment="Center"
                    Command="{Binding CreateBookingCommand}"
                    Content="+ Prenota">

                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource MahApps.Styles.Button.Dialogs.AccentHighlight}">

                        <Setter Property="Visibility"
                                Value="Visible" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedRoom}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </Button.Style>

            </Button>
        </Grid>
        
        <!-- ===================== -->
        <!-- LISTA GIORNI -->
        <!-- ===================== -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Days}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:DayBookingsPanel />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>
    
</UserControl>