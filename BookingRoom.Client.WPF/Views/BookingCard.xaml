<UserControl x:Class="BookingRoom.Client.WPF.Views.BookingCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220">

    <UserControl.Resources>

        <Style x:Key="BookingCardStyle"
               TargetType="Border">

            <Setter Property="CornerRadius"
                    Value="8" />
            <Setter Property="Margin"
                    Value="6" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Background"
                    Value="{Binding BackgroundColor}" />
            <Setter Property="BorderBrush"
                    Value="{Binding AccentColor}" />
            <Setter Property="BorderThickness"
                    Value="6,1,1,1" />

            <Setter Property="RenderTransformOrigin"
                    Value="0.5,0.5" />

            <!-- SHADOW -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6"
                                      ShadowDepth="2"
                                      Opacity="0.2" />
                </Setter.Value>
            </Setter>

            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <!-- HOVER -->
                <DataTrigger Binding="{Binding State}"
                             Value="Hover">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-4" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <!-- ACTIVE -->
                <DataTrigger Binding="{Binding State}"
                             Value="Active">
                    <Setter Property="BorderThickness"
                            Value="1" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="4"
                                              Opacity="0.4" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <!-- SELECTED -->
                <DataTrigger Binding="{Binding State}"
                             Value="Selected">
                    <Setter Property="BorderThickness"
                            Value="2" />
                </DataTrigger>

                <!-- DISABLED / PAST -->
                <DataTrigger Binding="{Binding State}"
                             Value="Disabled">
                    <Setter Property="Opacity"
                            Value="0.2" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="4"
                                              ShadowDepth="2"
                                              Opacity="0.2" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <DataTrigger Binding="{Binding State}"
                             Value="Past">
                    <Setter Property="Opacity"
                            Value="0.4" />

                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="4"
                                              ShadowDepth="2"
                                              Opacity="0.2" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Border Style="{StaticResource BookingCardStyle}"
            BorderThickness="6,1,1,1"
            BorderBrush="{Binding AccentColor}"
            MouseEnter="OnMouseEnter"
            MouseLeave="OnMouseLeave">

        <StackPanel Grid.Column="1"
                    Margin="10">

            <TextBlock Text="{Binding Title}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Foreground="{Binding TextColor}"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Text="{Binding TimeRange}"
                       FontSize="12"
                       Margin="0,4,0,0"
                       Foreground="{Binding TextColor}" />

        </StackPanel>
    </Border>
</UserControl>