<Window x:Class="BookingRoom.Client.WPF.Views.BookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Booking"
        Width="420"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- ===================== -->
        <!-- TEXTBOX STYLE MODERNO -->
        <!-- ===================== -->
        <Style TargetType="TextBox">
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Padding"
                    Value="6" />
            <Setter Property="BorderThickness"
                    Value="0,0,0,1" />
            <Setter Property="BorderBrush"
                    Value="#888" />

        </Style>

        <!-- ===================== -->
        <!-- COMBOBOX STYLE -->
        <!-- ===================== -->
        <Style TargetType="ComboBox">
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="BorderThickness"
                    Value="0,0,0,1" />
            <Setter Property="BorderBrush"
                    Value="#888" />

        </Style>

    </Window.Resources>

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TITLE ROOM -->
        <TextBlock Text="{Binding RoomName}"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15" />

        <!-- TITLE INPUT -->
        <TextBox Grid.Row="1"
                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,15"
                 Height="34" />

        <!-- START -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <DatePicker SelectedDate="{Binding StartDate}"
                        Width="150" />

            <ComboBox ItemsSource="{Binding Hours}"
                      SelectedItem="{Binding StartHour}"
                      Width="60"
                      Margin="10,0,0,0" />

            <ComboBox ItemsSource="{Binding Minutes}"
                      SelectedItem="{Binding StartMinute}"
                      Width="60"
                      Margin="5,0,0,0" />

        </StackPanel>

        <!-- END -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <DatePicker SelectedDate="{Binding EndDate}"
                        Width="150" />

            <ComboBox ItemsSource="{Binding Hours}"
                      SelectedItem="{Binding EndHour}"
                      Width="60"
                      Margin="10,0,0,0" />

            <ComboBox ItemsSource="{Binding Minutes}"
                      SelectedItem="{Binding EndMinute}"
                      Width="60"
                      Margin="5,0,0,0" />

        </StackPanel>
        
        <!-- ===================== -->
        <!-- BUTTON -->
        <!-- ===================== -->
        <Button Grid.Row="4"
                x:Name="ConfirmButton"
                Content="Conferma"
                Width="160"
                Height="40"
                FontSize="14"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Click="ConfirmButton_Click"
                IsEnabled="{Binding CanConfirm}" />

    </Grid>
</Window>